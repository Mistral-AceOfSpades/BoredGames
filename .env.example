# Copy this file to .env and fill in values

# Mistral AI — required for all AI features
MISTRAL_API_KEY=your-mistral-api-key

# App
SECRET_KEY=change-me-in-production
DEBUG=true

# Database (default: local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./boredgames.db

# Redis (optional — for WebSocket pub/sub in production)
REDIS_URL=redis://localhost:6379/0

# GitHub OAuth (optional — enables GitHub login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare R2 Storage (optional — for rulebook image storage)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=boredgames
